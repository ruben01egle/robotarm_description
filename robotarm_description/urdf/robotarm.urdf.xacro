<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robotarm">

  <xacro:arg name="use_hardware" default="false" />

  <xacro:include filename="$(find robotarm_description)/urdf/robotarm_geometry.xacro" />
  <xacro:include filename="$(find robotarm_description)/urdf/robotarm.ros2_control.xacro" />

  <xacro:robotarm_geometry />

  <xacro:robotarm_ros2_control name="moteus_hardware_system" use_hardware="$(arg use_hardware)" />

</robot>