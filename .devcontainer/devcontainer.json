{
    "name": "ROS 2 Development",
    "build": {
        "dockerfile": "Dockerfile"
    },

    "workspaceFolder": "/robotarm_description",
    "initializeCommand": "xhost +local:docker",

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-python.python",
                "ms-iot.vscode-ros",
                "redhat.vscode-yaml",
                "ms-vscode.cmake-tools"
            ]
        }
    },
    
    "mounts": [
        "source=${localWorkspaceFolder},target=/robotarm_description,type=bind",
        "source=/etc/localtime,target=/etc/localtime,type=bind,ro",
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
    ],
    
    "runArgs": [
        "--network=host",
        "--ipc=host",
        "--privileged",
        "--env=DISPLAY=${localEnv:DISPLAY}"
    ],

    "containerEnv": {
        "QT_QPA_PLATFORM": "xcb",
        "DISPLAY": "${localEnv:DISPLAY}"
    },
    
    "postCreateCommand": "rosdep update && rosdep install --from-paths src --ignore-src -r -y"
}